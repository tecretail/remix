{% liquid
  assign hosted_videos = product.media | where: 'media_type', 'video'
  assign external_videos = product.media | where: 'media_type', 'external_video'
  assign media_videos = hosted_videos | concat: external_videos
%}

{% if show_videos and product != blank and media_videos.size > 0 %}
  <div class="pg-product-videos" style="--pg-videos-bg: {{ videos_bg | default: '#eef4fc' }}; --pg-videos-heading: {{ videos_heading_color | default: '#0b1a3a' }};">
    {% if videos_heading != blank %}
      <h2 class="pg-product-videos__heading">{{ videos_heading }}</h2>
    {% endif %}

    <div class="pg-product-videos__carousel">
      <button class="pg-product-videos__nav pg-product-videos__nav--prev" type="button" aria-label="Videos anteriores">‹</button>
      <div class="pg-product-videos__rail">
      {% for media in media_videos %}
        {% liquid
          assign poster_url = ''
          if media.preview_image
            assign poster_url = media.preview_image | image_url: width: 1600
          endif
          assign best_source = nil
          assign best_w = 0
          if media.sources != blank
            for source in media.sources
              if source.format == 'mp4' and source.width > best_w
                assign best_w = source.width
                assign best_source = source
              endif
            endfor
            if best_source == nil
              assign best_source = media.sources.last
            endif
          endif
        %}
        <article class="pg-product-video-card">
          <div class="pg-product-video-card__media">
            {% if media.media_type == 'external_video' %}
              {{ media | external_video_tag: class: 'pg-product-videos__el pg-product-videos__el--external', loading: 'lazy' }}
            {% else %}
              <video
                class="pg-product-videos__el"
                {% if poster_url != blank %}poster="{{ poster_url }}"{% endif %}
                playsinline
                preload="metadata"
                controlslist="nodownload nofullscreen noremoteplayback"
                disablepictureinpicture
              >
                {% if best_source %}
                  <source src="{{ best_source.url }}" type="{{ best_source.mime_type }}">
                {% endif %}
                {% for source in media.sources %}
                  {% if best_source == blank or source.url != best_source.url %}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {% endif %}
                {% endfor %}
              </video>
            {% endif %}
            <button class="pg-product-videos__play" type="button" aria-label="Reproducir video">
              <span class="pg-product-videos__play-icon"></span>
            </button>
          </div>
        </article>
      {% endfor %}
      </div>
      <button class="pg-product-videos__nav pg-product-videos__nav--next" type="button" aria-label="Videos siguientes">›</button>
    </div>
    {% if show_video_stars != false %}
      <div class="pg-product-videos__proof">
        <span class="pg-product-videos__stars">{{ videos_stars_text | default: '★★★★★' }}</span>
        {% if videos_social_proof != blank %}
          <span class="pg-product-videos__proof-text">{{ videos_social_proof }}</span>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <script>
    (function () {
      var wrap = document.currentScript;
      while (wrap && wrap.previousElementSibling) {
        wrap = wrap.previousElementSibling;
        if (wrap.classList && wrap.classList.contains('pg-product-videos')) break;
      }
      if (!wrap || !wrap.classList || !wrap.classList.contains('pg-product-videos')) {
        wrap = document.querySelector('.pg-product-videos');
      }
      if (!wrap || wrap.dataset.ready === '1') return;
      wrap.dataset.ready = '1';

      var rail = wrap.querySelector('.pg-product-videos__rail');
      if (!rail) return;

      function updateScrollable() {
        wrap.classList.toggle('is-scrollable', rail.scrollWidth > rail.clientWidth + 8);
      }
      updateScrollable();
      window.addEventListener('resize', updateScrollable);

      function scrollByCard(dir) {
        var card = rail.querySelector('.pg-product-video-card');
        var amount = card ? card.getBoundingClientRect().width + 12 : rail.clientWidth * 0.7;
        rail.scrollBy({ left: dir * amount, behavior: 'smooth' });
      }

      var prevBtn = wrap.querySelector('.pg-product-videos__nav--prev');
      var nextBtn = wrap.querySelector('.pg-product-videos__nav--next');
      if (prevBtn) prevBtn.addEventListener('click', function (e) { e.preventDefault(); scrollByCard(-1); });
      if (nextBtn) nextBtn.addEventListener('click', function (e) { e.preventDefault(); scrollByCard(1); });

      var isDown = false;
      var startX = 0;
      var scrollLeft = 0;
      var dragged = false;

      rail.addEventListener('mousedown', function (e) {
        if (e.button !== 0) return;
        isDown = true;
        dragged = false;
        startX = e.pageX;
        scrollLeft = rail.scrollLeft;
      });

      window.addEventListener('mousemove', function (e) {
        if (!isDown) return;
        var walk = e.pageX - startX;
        if (Math.abs(walk) > 6) {
          dragged = true;
          rail.classList.add('is-dragging');
          e.preventDefault();
          rail.scrollLeft = scrollLeft - walk;
        }
      });

      window.addEventListener('mouseup', function () {
        isDown = false;
        rail.classList.remove('is-dragging');
      });

      rail.addEventListener('click', function (e) {
        if (!dragged) return;
        e.preventDefault();
        e.stopPropagation();
        dragged = false;
      }, true);

      wrap.querySelectorAll('.pg-product-video-card').forEach(function (card) {
        var video = card.querySelector('video');
        var playBtn = card.querySelector('.pg-product-videos__play');
        if (!video || !playBtn) return;

        function pauseOthers() {
          wrap.querySelectorAll('.pg-product-video-card.is-playing').forEach(function (other) {
            if (other === card) return;
            var otherVideo = other.querySelector('video');
            other.classList.remove('is-playing');
            if (otherVideo) otherVideo.pause();
          });
        }

        function playWithSound() {
          pauseOthers();
          video.muted = false;
          video.volume = 1;
          video.controls = false;
          var playPromise = video.play();
          card.classList.add('is-playing');
          if (playPromise && playPromise.catch) {
            playPromise.catch(function () {
              video.muted = false;
              video.play();
            });
          }
        }

        playBtn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          if (dragged) return;
          playWithSound();
        });

        card.querySelector('.pg-product-video-card__media').addEventListener('click', function (e) {
          if (dragged) return;
          if (!card.classList.contains('is-playing')) return;
          if (e.target === playBtn || playBtn.contains(e.target)) return;
          e.preventDefault();
          if (video.paused) {
            playWithSound();
          } else {
            video.pause();
            card.classList.remove('is-playing');
          }
        });

        video.addEventListener('ended', function () {
          card.classList.remove('is-playing');
          video.currentTime = 0;
        });
      });
    })();
  </script>
{% endif %}
