{% comment %}
  Shared style + text settings for product buybox sections.
  Include via: {% render 'pg-buybox-from-section', product: product, section_obj: section %}
{% endcomment %}

{% liquid
  assign sec = section_obj | default: section

  assign _show_description = sec.settings.show_description
  if hide_description
    assign _show_description = false
  endif
%}

{% render 'pg-product-buybox',
  product: product,
  buybox_blocks: sec.blocks,
  show_bar: sec.settings.show_bar,
  show_back: sec.settings.show_back,
  show_description: _show_description,
  show_rating: sec.settings.show_rating,
  show_benefits: sec.settings.show_benefits,
  show_hot_sale: sec.settings.show_hot_sale,
  show_releasit: sec.settings.show_releasit,
  releasit_label: sec.settings.releasit_label,
  bar_text: sec.settings.bar_text,
  rating_text: sec.settings.rating_text,
  doctor_badge: sec.settings.doctor_badge,
  show_social_stack: sec.settings.show_social_stack,
  social_sold: sec.settings.social_sold,
  social_guide: sec.settings.social_guide,
  urgency_bar_text: sec.settings.urgency_bar_text,
  show_delivery_truck: sec.settings.show_delivery_truck,
  courier_icon: sec.settings.courier_icon,
  delivery_tooltip_text: sec.settings.delivery_tooltip_text,
  delivery_gift_text: sec.settings.delivery_gift_text,
  show_trust_accordion: sec.settings.show_trust_accordion,
  acc_ship_title: sec.settings.acc_ship_title,
  acc_ship_body: sec.settings.acc_ship_body,
  acc_guarantee_title: sec.settings.acc_guarantee_title,
  acc_guarantee_body: sec.settings.acc_guarantee_body,
  benefit_1: sec.settings.benefit_1,
  benefit_2: sec.settings.benefit_2,
  benefit_3: sec.settings.benefit_3,
  hot_sale_label: sec.settings.hot_sale_label,
  hot_sale_text: sec.settings.hot_sale_text,
  offer_badge: sec.settings.offer_badge,
  in_stock_label: sec.settings.in_stock_label,
  sold_out_label: sec.settings.sold_out_label,
  total_label: sec.settings.total_label,
  save_label: sec.settings.save_label,
  cta_label: sec.settings.cta_label,
  back_label: sec.settings.back_label,
  description_title: sec.settings.description_title,
  off_prefix: sec.settings.off_prefix,
  off_suffix: sec.settings.off_suffix,
  description_placement: sec.settings.description_placement,
  gallery_position: sec.settings.gallery_position,
  title_size: sec.settings.title_size,
  cta_font_size: sec.settings.cta_font_size,
  cta_pad_y: sec.settings.cta_pad_y,
  cta_pad_x: sec.settings.cta_pad_x,
  cta_radius: sec.settings.cta_radius,
  desc_font_size: sec.settings.desc_font_size,
  desc_max_width: sec.settings.desc_max_width,
  desc_pad: sec.settings.desc_pad,
  desc_radius: sec.settings.desc_radius,
  desc_margin_top: sec.settings.desc_margin_top,
  section_max_width: sec.settings.section_max_width,
  section_pad_y: sec.settings.section_pad_y,
  section_pad_x: sec.settings.section_pad_x,
  gallery_min_height: sec.settings.gallery_min_height,
  color_bar: sec.settings.color_bar,
  color_cta_bg: sec.settings.color_cta_bg,
  color_cta_text: sec.settings.color_cta_text,
  color_cta_border: sec.settings.color_cta_border,
  color_desc_bg: sec.settings.color_desc_bg,
  color_desc_title: sec.settings.color_desc_title,
  color_title: sec.settings.color_title,
  color_badge: sec.settings.color_badge,
  color_off: sec.settings.color_off,
  show_videos: sec.settings.show_videos,
  videos_from_media: sec.settings.videos_from_media,
  show_video_captions: sec.settings.show_video_captions,
  show_video_stars: sec.settings.show_video_stars,
  videos_stars_text: sec.settings.videos_stars_text,
  videos_stars_position: sec.settings.videos_stars_position,
  videos_heading: sec.settings.videos_heading,
  videos_social_proof: sec.settings.videos_social_proof,
  videos_bg: sec.settings.videos_bg,
  videos_heading_color: sec.settings.videos_heading_color,
  videos_caption_bg: sec.settings.videos_caption_bg,
  videos_caption_color: sec.settings.videos_caption_color,
  videos_stars_color: sec.settings.videos_stars_color
%}
