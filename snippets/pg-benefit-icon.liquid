{% comment %} Icono SVG para tarjetas de beneficio {% endcomment %}
{% liquid
  assign icon_key = icon | default: '✓' | strip
%}

{% case icon_key %}
  {% when '✓', 'check', 'Check', 'CHECK' %}
    <svg class="pg-p-benefit-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {% when '★', 'star', 'Star', 'STAR' %}
    <svg class="pg-p-benefit-svg pg-p-benefit-svg--fill" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="currentColor"/>
    </svg>
  {% when '♥', 'heart', 'Heart', 'HEART', '❤', '❤️' %}
    <svg class="pg-p-benefit-svg pg-p-benefit-svg--fill" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="currentColor"/>
    </svg>
  {% else %}
    <span class="pg-p-benefit-icon-fallback">{{ icon_key }}</span>
{% endcase %}
