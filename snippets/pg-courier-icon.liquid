{% comment %}
  Icono courier — cuadrado 32x32 para evitar deformacion al escalar.
  Uso: {% render 'pg-courier-icon', type: 'truck' %}
{% endcomment %}
{% liquid
  assign icon_type = type | default: 'truck'
%}

{% if icon_type == 'package' %}
  <svg class="pg-courier-art" viewBox="0 0 32 32" width="32" height="32" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <ellipse cx="16" cy="28" rx="10" ry="1.5" fill="#054497" opacity="0.15"/>
    <path d="M8 14 16 9l8 5v12H8V14z" fill="#054497"/>
    <path d="M8 14 16 19l8-5" stroke="#f39200" stroke-width="1.5" fill="none"/>
    <path d="M16 19v7" stroke="#fff" stroke-width="1" opacity="0.35"/>
    <circle cx="16" cy="15" r="2.5" fill="#2f7a3a"/>
    <path d="M14.8 15l1 1 2.2-2.2" stroke="#fff" stroke-width="1" fill="none" stroke-linecap="round"/>
  </svg>
{% elsif icon_type == 'bike' %}
  <svg class="pg-courier-art" viewBox="0 0 32 32" width="32" height="32" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <ellipse cx="16" cy="28" rx="11" ry="1.5" fill="#054497" opacity="0.15"/>
    <circle class="pg-courier-wheel" cx="10" cy="23" r="4.5" fill="#0b1a3a"/>
    <circle cx="10" cy="23" r="1.6" fill="#fff"/>
    <circle class="pg-courier-wheel" cx="22" cy="23" r="4.5" fill="#0b1a3a"/>
    <circle cx="22" cy="23" r="1.6" fill="#fff"/>
    <rect x="6" y="10" width="9" height="8" rx="1.5" fill="#054497"/>
    <rect x="6" y="15" width="9" height="1.5" fill="#f39200"/>
    <path d="M10 23h7l5-8h5l3 4" stroke="#0a6fd4" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M19 11h4" stroke="#054497" stroke-width="2" stroke-linecap="round"/>
    <path d="M21 8v6" stroke="#054497" stroke-width="2" stroke-linecap="round"/>
  </svg>
{% elsif icon_type == 'car' %}
  <svg class="pg-courier-art" viewBox="0 0 32 32" width="32" height="32" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <ellipse cx="16" cy="28" rx="12" ry="1.5" fill="#054497" opacity="0.15"/>
    <path d="M4 21c0-.8.7-1.5 1.5-1.5h3l3-5.5c.5-.8 1.4-1.3 2.4-1.3h8c.8 0 1.6.4 2 1l2.5 4.8h5c.9 0 1.6.7 1.6 1.5V21H4z" fill="#054497"/>
    <path d="M7 20 10 13h9l3 7H7z" fill="#0a6fd4"/>
    <rect x="8" y="14" width="4" height="3" rx="0.5" fill="#eaf1fb"/>
    <rect x="13.5" y="14" width="4" height="3" rx="0.5" fill="#eaf1fb"/>
    <rect x="19" y="14.5" width="3" height="2.5" rx="0.5" fill="#eaf1fb" opacity="0.9"/>
    <path d="M6 19.5h20" stroke="#f39200" stroke-width="1.5" stroke-linecap="round"/>
    <circle class="pg-courier-wheel" cx="10" cy="21" r="3" fill="#0b1a3a"/>
    <circle cx="10" cy="21" r="1.2" fill="#fff"/>
    <circle class="pg-courier-wheel" cx="23" cy="21" r="3" fill="#0b1a3a"/>
    <circle cx="23" cy="21" r="1.2" fill="#fff"/>
  </svg>
{% else %}
  <svg class="pg-courier-art" viewBox="0 0 32 32" width="32" height="32" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <ellipse cx="16" cy="28" rx="12" ry="1.5" fill="#054497" opacity="0.15"/>
    <rect x="3" y="13" width="13" height="11" rx="1.5" fill="#054497"/>
    <rect x="3" y="21" width="13" height="1.5" rx="0.5" fill="#f39200"/>
    <path d="M16 13h9l5 4v7H16V13z" fill="#0a6fd4"/>
    <rect x="18" y="15" width="5" height="4" rx="0.5" fill="#eaf1fb"/>
    <rect x="5" y="15" width="9" height="5" rx="0.5" fill="#fff" opacity="0.12"/>
    <circle class="pg-courier-wheel" cx="9" cy="25" r="3" fill="#0b1a3a"/>
    <circle cx="9" cy="25" r="1.2" fill="#fff"/>
    <circle class="pg-courier-wheel" cx="23" cy="25" r="3" fill="#0b1a3a"/>
    <circle cx="23" cy="25" r="1.2" fill="#fff"/>
  </svg>
{% endif %}
