{% comment %}
  Notificaciones falsas de prueba social — SOLO preview / editor.
  No se cargan en la tienda publicada (theme role main + sin design mode).
{% endcomment %}
{% liquid
  assign pg_show_demo_toasts = false
  if request.design_mode or request.visual_preview_mode
    assign pg_show_demo_toasts = true
  endif
  if theme.role != 'main'
    assign pg_show_demo_toasts = true
  endif
%}
{% if pg_show_demo_toasts %}
  {% liquid
    assign pg_toast_img = ''
    assign pg_toast_title = shop.name
    if product != blank
      assign pg_toast_title = product.title | truncate: 48
      if product.featured_image
        assign pg_toast_img = product.featured_image | image_url: width: 120
      endif
    elsif collections.all.products.first != blank
      assign _p = collections.all.products.first
      assign pg_toast_title = _p.title | truncate: 48
      if _p.featured_image
        assign pg_toast_img = _p.featured_image | image_url: width: 120
      endif
    endif
  %}
  <div id="pgDemoToasts" class="pg-demo-toasts" aria-live="polite" aria-atomic="true" hidden data-pg-demo="1"></div>
  <script type="application/json" id="pgDemoToastsData">
    {
      "productTitle": {{ pg_toast_title | json }},
      "productImage": {{ pg_toast_img | json }},
      "shop": {{ shop.name | json }}
    }
  </script>
  <style>
    .pg-demo-toasts {
      position: fixed;
      left: 14px;
      bottom: max(18px, env(safe-area-inset-bottom, 0px));
      z-index: 99990;
      width: min(340px, calc(100vw - 28px));
      pointer-events: none;
      font-family: var(--pg-font, "Frank Ruhl Libre", Georgia, serif);
    }
    .pg-demo-toast {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      background: #ffffff;
      border: 1px solid rgba(5, 68, 151, 0.16);
      border-radius: 14px;
      box-shadow: 0 12px 32px rgba(11, 26, 58, 0.18), 0 0 0 1px rgba(255, 255, 255, 0.6) inset;
      transform: translateY(18px);
      opacity: 0;
      transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.28s ease;
      pointer-events: auto;
    }
    .pg-demo-toast.is-in {
      transform: translateY(0);
      opacity: 1;
    }
    .pg-demo-toast.is-out {
      transform: translateY(12px);
      opacity: 0;
    }
    .pg-demo-toast__img {
      width: 48px;
      height: 48px;
      border-radius: 10px;
      object-fit: cover;
      background: #eef3fb;
      border: 1px solid #e3e8f0;
      flex: 0 0 48px;
    }
    .pg-demo-toast__img--empty {
      display: flex;
      align-items: center;
      justify-content: center;
      color: #054497;
      font-size: 18px;
      font-weight: 800;
    }
    .pg-demo-toast__body {
      min-width: 0;
      flex: 1 1 auto;
    }
    .pg-demo-toast__line1 {
      font-size: 13px;
      font-weight: 800;
      color: #0b1a3a;
      line-height: 1.25;
      margin: 0 0 2px;
    }
    .pg-demo-toast__line1 strong {
      color: #054497;
      font-weight: 800;
    }
    .pg-demo-toast__line2 {
      font-size: 12px;
      font-weight: 600;
      color: #5e6d7a;
      line-height: 1.3;
      margin: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .pg-demo-toast__time {
      display: block;
      margin-top: 3px;
      font-size: 11px;
      font-weight: 700;
      color: #158a2e;
      letter-spacing: 0.02em;
    }
    .pg-demo-toast__close {
      flex: 0 0 auto;
      width: 22px;
      height: 22px;
      border: 0;
      border-radius: 50%;
      background: #eef3fb;
      color: #5e6d7a;
      font-size: 14px;
      line-height: 1;
      cursor: pointer;
      padding: 0;
    }
    .pg-demo-toast__badge {
      position: absolute;
      top: -8px;
      left: 12px;
      background: #054497;
      color: #fff;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 3px 7px;
      border-radius: 999px;
    }
    .pg-demo-toast {
      position: relative;
    }
    @media (max-width: 900px) {
      .pg-demo-toasts {
        left: 10px;
        right: 10px;
        width: auto;
        bottom: max(72px, calc(env(safe-area-inset-bottom, 0px) + 64px));
      }
    }
  </style>
  <script>
    (function () {
      // Solo preview / editor (doble chequeo por si el snippet se cachea)
      var preview =
        !!(window.Shopify && Shopify.designMode) ||
        /[?&]preview_theme_id=/.test(location.search) ||
        /[?&]pg_toasts=1/.test(location.search) ||
        document.body.classList.contains('shopify-design-mode');
      if (!preview && !document.getElementById('pgDemoToasts')) return;
      // Si Liquid ya decidió mostrar, seguimos aunque no haya query (theme unpublished)
      var host = document.getElementById('pgDemoToasts');
      if (!host) return;

      var data = { productTitle: 'este producto', productImage: '', shop: '' };
      try {
        var raw = document.getElementById('pgDemoToastsData');
        if (raw) data = JSON.parse(raw.textContent || '{}');
      } catch (e) {}

      var names = [
        'María', 'Carlos', 'Lucía', 'José', 'Ana', 'Diego', 'Valeria', 'Miguel',
        'Camila', 'Andrés', 'Sofía', 'Pedro', 'Elena', 'Jorge', 'Patricia', 'Luis'
      ];
      var cities = [
        'Lima', 'Arequipa', 'Trujillo', 'Cusco', 'Piura', 'Chiclayo',
        'Huancayo', 'Iquitos', 'Tacna', 'Callao', 'Surco', 'San Borja'
      ];
      var times = [
        'hace 1 min', 'hace 2 min', 'hace 3 min', 'hace 5 min',
        'hace 8 min', 'hace 12 min', 'hace unos momentos'
      ];

      function pick(arr) {
        return arr[Math.floor(Math.random() * arr.length)];
      }

      function showOne() {
        if (document.hidden) return;
        host.hidden = false;
        host.innerHTML = '';

        var name = pick(names);
        var city = pick(cities);
        var when = pick(times);
        var title = data.productTitle || 'este producto';

        var card = document.createElement('div');
        card.className = 'pg-demo-toast';
        card.setAttribute('role', 'status');

        var badge = document.createElement('span');
        badge.className = 'pg-demo-toast__badge';
        badge.textContent = 'Demo preview';
        card.appendChild(badge);

        if (data.productImage) {
          var img = document.createElement('img');
          img.className = 'pg-demo-toast__img';
          img.src = data.productImage;
          img.alt = '';
          img.width = 48;
          img.height = 48;
          card.appendChild(img);
        } else {
          var ph = document.createElement('div');
          ph.className = 'pg-demo-toast__img pg-demo-toast__img--empty';
          ph.textContent = '✓';
          card.appendChild(ph);
        }

        var body = document.createElement('div');
        body.className = 'pg-demo-toast__body';
        body.innerHTML =
          '<p class="pg-demo-toast__line1"><strong>' + name + '</strong> de ' + city + ' compró</p>' +
          '<p class="pg-demo-toast__line2">' + title.replace(/</g, '&lt;') + '</p>' +
          '<span class="pg-demo-toast__time">' + when + '</span>';
        card.appendChild(body);

        var close = document.createElement('button');
        close.type = 'button';
        close.className = 'pg-demo-toast__close';
        close.setAttribute('aria-label', 'Cerrar');
        close.textContent = '×';
        close.addEventListener('click', function () {
          hide(card, true);
        });
        card.appendChild(close);

        host.appendChild(card);
        requestAnimationFrame(function () {
          card.classList.add('is-in');
        });

        setTimeout(function () {
          hide(card, false);
        }, 5200);
      }

      function hide(card, immediate) {
        if (!card || !card.parentNode) return;
        card.classList.remove('is-in');
        card.classList.add('is-out');
        setTimeout(function () {
          if (card.parentNode) card.parentNode.removeChild(card);
          if (!host.children.length) host.hidden = true;
        }, immediate ? 80 : 320);
      }

      // Primera notificación pronto, luego cada 9–14 s
      setTimeout(showOne, 2500);
      setInterval(function () {
        if (host.querySelector('.pg-demo-toast')) return;
        showOne();
      }, 9000 + Math.floor(Math.random() * 5000));
    })();
  </script>
{% endif %}
