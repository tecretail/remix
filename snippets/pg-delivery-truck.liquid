{% comment %} Courier animado — debajo de la barra azul {% endcomment %}
<div class="pg-p-delivery-track" data-pg-delivery aria-hidden="true">
  <div class="pg-p-delivery-road">
    <span class="pg-p-delivery-line"></span>
    <div class="pg-p-delivery-courier">
      <svg viewBox="0 0 72 56" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="3" y="12" width="22" height="18" rx="3" fill="#054497"/>
        <rect x="3" y="24" width="22" height="3" rx="1" fill="#f39200"/>
        <path d="M25 26c0-6 5-10 11-10h8c3 0 6 2 7 5l3 9H25V26z" fill="#0a6fd4"/>
        <ellipse cx="36" cy="28" rx="9" ry="5.5" fill="#054497"/>
        <path d="M45 22h10" stroke="#054497" stroke-width="3" stroke-linecap="round"/>
        <path d="M52 18v8" stroke="#054497" stroke-width="3" stroke-linecap="round"/>
        <path d="M48 18h8" stroke="#f39200" stroke-width="2.5" stroke-linecap="round"/>
        <circle class="pg-courier-wheel" cx="20" cy="40" r="6" fill="#0b1a3a"/>
        <circle cx="20" cy="40" r="2.2" fill="#fff"/>
        <circle class="pg-courier-wheel" cx="52" cy="40" r="6" fill="#0b1a3a"/>
        <circle cx="52" cy="40" r="2.2" fill="#fff"/>
        <path d="M8 16h8M8 20h6" stroke="#eaf1fb" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </div>
  </div>
</div>
<script>
  (function () {
    function pgCourierDrive(track) {
      var road = track.querySelector('.pg-p-delivery-road');
      var courier = track.querySelector('.pg-p-delivery-courier');
      if (!road || !courier) return;
      var travel = Math.max(0, road.clientWidth - courier.clientWidth);
      courier.style.setProperty('--pg-cart-travel', travel + 'px');
    }
    function pgCourierInitAll() {
      document.querySelectorAll('[data-pg-delivery]').forEach(pgCourierDrive);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', pgCourierInitAll);
    } else {
      pgCourierInitAll();
    }
    window.addEventListener('resize', pgCourierInitAll);
    document.addEventListener('shopify:section:load', pgCourierInitAll);
  })();
</script>
