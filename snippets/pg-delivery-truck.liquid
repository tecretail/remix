{% comment %} Courier v14 — camion, luego envio, luego regalo, repite {% endcomment %}
{% liquid
  assign courier_icon = courier_icon | default: 'truck'
  assign delivery_tooltip_text = delivery_tooltip_text | default: 'Envío gratis a todo el Perú'
  assign delivery_gift_text = delivery_gift_text | default: 'Cada pedido tiene un regalo especial'
%}
<div class="pg-p-delivery-track" data-pg-delivery data-pg-courier-v="14">
  <div class="pg-p-delivery-stage">
    <div class="pg-p-delivery-road">
      <span class="pg-p-delivery-line"></span>
      <div class="pg-p-delivery-courier">
        {% render 'pg-courier-icon', type: courier_icon %}
      </div>
    </div>
    <div class="pg-p-delivery-message" data-pg-msg-panel="0" role="status" aria-live="polite">
      <span class="pg-p-delivery-message__icon" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 7.2L5.8 10 11 4.5" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="pg-p-delivery-message__text">
        {% if delivery_tooltip_text contains 'gratis' %}
          {% assign tip_parts = delivery_tooltip_text | split: 'gratis' %}
          {{ tip_parts[0] }}<em class="pg-p-delivery-message__em">gratis</em>{{ tip_parts[1] }}
        {% else %}
          {{ delivery_tooltip_text }}
        {% endif %}
      </span>
    </div>
    <div class="pg-p-delivery-message" data-pg-msg-panel="1" role="status" aria-live="polite">
      <span class="pg-p-delivery-message__icon pg-p-delivery-message__icon--gift" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="8" width="18" height="13" rx="1"/>
          <path d="M12 8v13"/>
          <path d="M3 12h18"/>
          <path d="M7.5 8C6 8 5 6.5 5 5a2 2 0 0 1 4 0c0 2-2 3-2 3"/>
          <path d="M16.5 8c1.5 0 2.5-1.5 2.5-3a2 2 0 0 0-4 0c0 2 2 3 2 3"/>
        </svg>
      </span>
      <span class="pg-p-delivery-message__text">
        {% if delivery_gift_text contains 'regalo especial' %}
          {% assign gift_parts = delivery_gift_text | split: 'regalo especial' %}
          {{ gift_parts[0] }}<em class="pg-p-delivery-message__em">regalo especial</em>{{ gift_parts[1] }}
        {% else %}
          {{ delivery_gift_text }}
        {% endif %}
      </span>
    </div>
  </div>
</div>
