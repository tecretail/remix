{% comment %} Courier animado — debajo de la barra azul {% endcomment %}
<div class="pg-p-delivery-track" data-pg-delivery aria-hidden="true">
  <div class="pg-p-delivery-road">
    <span class="pg-p-delivery-line"></span>
    <div class="pg-p-delivery-courier">
      <svg viewBox="0 0 100 50" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M12 34h76c3 0 5-2 5-5v-2c0-2-1-4-3-4h-5l-8-10c-1-1-2-2-4-2H38l-10 4-8 6H14c-2 0-4 2-4 5v3c0 3 2 5 5 5z" fill="#054497"/>
        <path d="M26 34V27l7-9h13l7 4h15l9 8v4H26z" fill="#0a6fd4"/>
        <rect x="30" y="22" width="13" height="7" rx="1.5" fill="#eaf1fb"/>
        <rect x="46" y="22" width="13" height="7" rx="1.5" fill="#eaf1fb"/>
        <rect x="62" y="24" width="10" height="6" rx="1.5" fill="#eaf1fb" opacity="0.9"/>
        <path d="M18 31h64" stroke="#f39200" stroke-width="2.5" stroke-linecap="round"/>
        <circle class="pg-courier-wheel" cx="28" cy="36" r="7" fill="#0b1a3a"/>
        <circle cx="28" cy="36" r="2.8" fill="#fff"/>
        <circle class="pg-courier-wheel" cx="74" cy="36" r="7" fill="#0b1a3a"/>
        <circle cx="74" cy="36" r="2.8" fill="#fff"/>
        <circle cx="86" cy="28" r="2.5" fill="#f39200"/>
        <circle cx="14" cy="28" r="2" fill="#d40000"/>
      </svg>
    </div>
  </div>
</div>
<script>
  (function () {
    function pgCourierDrive(track) {
      var road = track.querySelector('.pg-p-delivery-road');
      var courier = track.querySelector('.pg-p-delivery-courier');
      if (!road || !courier) return;
      var travel = Math.max(0, road.clientWidth - courier.clientWidth);
      courier.style.setProperty('--pg-cart-travel', travel + 'px');
    }
    function pgCourierInitAll() {
      document.querySelectorAll('[data-pg-delivery]').forEach(pgCourierDrive);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', pgCourierInitAll);
    } else {
      pgCourierInitAll();
    }
    window.addEventListener('resize', pgCourierInitAll);
    document.addEventListener('shopify:section:load', pgCourierInitAll);
  })();
</script>
