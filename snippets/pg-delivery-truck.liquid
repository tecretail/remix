{% comment %} Courier animado v4 — vehiculo rediseñado (silueta limpia, colores marca) {% endcomment %}
{% liquid
  assign courier_icon = courier_icon | default: 'car'
%}
<div class="pg-p-delivery-track" data-pg-delivery data-pg-courier-v="4" aria-hidden="true">
  <div class="pg-p-delivery-road">
    <span class="pg-p-delivery-line"></span>
    <div class="pg-p-delivery-courier">
      {% if courier_icon == 'bike' %}
        <svg class="pg-courier-art" viewBox="0 0 100 54" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <ellipse cx="50" cy="48" rx="36" ry="3" fill="#054497" opacity="0.15"/>
          <circle class="pg-courier-wheel" cx="28" cy="40" r="8" fill="#0b1a3a"/>
          <circle cx="28" cy="40" r="3" fill="#fff"/>
          <circle class="pg-courier-wheel" cx="72" cy="40" r="8" fill="#0b1a3a"/>
          <circle cx="72" cy="40" r="3" fill="#fff"/>
          <rect x="10" y="14" width="22" height="18" rx="3" fill="#054497"/>
          <rect x="10" y="26" width="22" height="3" fill="#f39200"/>
          <path d="M28 40h16l10-16h14l8 10" stroke="#0a6fd4" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M58 18h12" stroke="#054497" stroke-width="3" stroke-linecap="round"/>
          <path d="M64 12v14" stroke="#054497" stroke-width="3" stroke-linecap="round"/>
        </svg>
      {% elsif courier_icon == 'package' %}
        <svg class="pg-courier-art" viewBox="0 0 80 54" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <ellipse cx="40" cy="48" rx="28" ry="3" fill="#054497" opacity="0.15"/>
          <path d="M16 20 40 10l24 10v22H16V20z" fill="#054497"/>
          <path d="M16 20 40 30l24-10" stroke="#f39200" stroke-width="3" fill="none"/>
          <path d="M40 30v22" stroke="#fff" stroke-width="2" opacity="0.45"/>
          <rect x="30" y="32" width="20" height="4" rx="1" fill="#f39200"/>
          <circle cx="40" cy="22" r="5" fill="#2f7a3a"/>
          <path d="M37.5 22l2 2 4-4" stroke="#fff" stroke-width="1.6" fill="none" stroke-linecap="round"/>
        </svg>
      {% elsif courier_icon == 'car' %}
        <svg class="pg-courier-art" viewBox="0 0 100 44" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <ellipse cx="50" cy="41" rx="38" ry="2" fill="#054497" opacity="0.12"/>
          <path d="M10 30c0-1.1.9-2 2-2h7l6.5-10.5c.7-1.1 2-1.8 3.4-1.8h19c1.2 0 2.3.5 3 1.4l4.8 7.9h23c1.7 0 3 1.3 3 3v1H10V30z" fill="#054497"/>
          <path d="M18 28.5 25 18h21l5.5 10.5H18z" fill="#0a6fd4"/>
          <rect x="22" y="19.5" width="9" height="5.5" rx="1" fill="#eaf1fb"/>
          <rect x="35" y="19.5" width="9" height="5.5" rx="1" fill="#eaf1fb"/>
          <rect x="48" y="20.5" width="7" height="4.5" rx="1" fill="#eaf1fb" opacity="0.85"/>
          <path d="M14 27.5h68" stroke="#f39200" stroke-width="2" stroke-linecap="round"/>
          <circle class="pg-courier-wheel" cx="28" cy="30" r="5" fill="#0b1a3a"/>
          <circle cx="28" cy="30" r="2" fill="#fff"/>
          <circle class="pg-courier-wheel" cx="72" cy="30" r="5" fill="#0b1a3a"/>
          <circle cx="72" cy="30" r="2" fill="#fff"/>
          <circle cx="86" cy="24" r="1.8" fill="#f39200"/>
        </svg>
      {% else %}
        <svg class="pg-courier-art" viewBox="0 0 100 44" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <ellipse cx="50" cy="41" rx="40" ry="2" fill="#054497" opacity="0.12"/>
          <path d="M8 30V18c0-1.5 1.2-2.5 2.5-2.5h34c.8 0 1.5.4 2 1l5 7h24c2.2 0 4 1.5 4 3.5V30H8z" fill="#054497"/>
          <path d="M46.5 15.5 54 23H46.5V15.5z" fill="#0a6fd4"/>
          <rect x="47" y="17" width="6" height="5" rx="0.5" fill="#eaf1fb"/>
          <rect x="12" y="20" width="30" height="7" rx="1" fill="#ffffff" opacity="0.1"/>
          <rect x="8" y="27" width="36" height="2" rx="1" fill="#f39200"/>
          <circle class="pg-courier-wheel" cx="24" cy="32" r="5" fill="#0b1a3a"/>
          <circle cx="24" cy="32" r="2" fill="#fff"/>
          <circle class="pg-courier-wheel" cx="72" cy="32" r="5" fill="#0b1a3a"/>
          <circle cx="72" cy="32" r="2" fill="#fff"/>
          <circle cx="88" cy="24" r="1.8" fill="#f39200"/>
        </svg>
      {% endif %}
    </div>
  </div>
</div>
<script>
  (function () {
    function pgCourierDrive(track) {
      var road = track.querySelector('.pg-p-delivery-road');
      var courier = track.querySelector('.pg-p-delivery-courier');
      if (!road || !courier) return;
      var travel = Math.max(0, road.clientWidth - courier.offsetWidth);
      courier.style.setProperty('--pg-cart-travel', travel + 'px');
    }
    function pgCourierInitAll() {
      document.querySelectorAll('[data-pg-delivery]').forEach(pgCourierDrive);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', pgCourierInitAll);
    } else {
      pgCourierInitAll();
    }
    window.addEventListener('resize', pgCourierInitAll);
    document.addEventListener('shopify:section:load', pgCourierInitAll);
  })();
</script>
