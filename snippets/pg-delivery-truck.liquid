{% comment %} Courier animado — debajo de la barra azul {% endcomment %}
<div class="pg-p-delivery-track" data-pg-delivery aria-hidden="true">
  <div class="pg-p-delivery-road">
    <span class="pg-p-delivery-line"></span>
    <div class="pg-p-delivery-courier">
      <svg viewBox="0 0 88 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="4" y="10" width="38" height="24" rx="4" fill="#054497"/>
        <rect x="4" y="26" width="38" height="4" rx="1" fill="#f39200"/>
        <path d="M42 10h26v24H42V10z" fill="#0a6fd4"/>
        <rect x="45" y="14" width="14" height="10" rx="2" fill="#eaf1fb"/>
        <rect x="10" y="15" width="14" height="10" rx="2" fill="#fff" fill-opacity="0.2"/>
        <path d="M12 17h10M12 21h7" stroke="#eaf1fb" stroke-width="1.5" stroke-linecap="round"/>
        <circle class="pg-courier-wheel" cx="20" cy="36" r="5.5" fill="#0b1a3a"/>
        <circle cx="20" cy="36" r="2" fill="#fff"/>
        <circle class="pg-courier-wheel" cx="58" cy="36" r="5.5" fill="#0b1a3a"/>
        <circle cx="58" cy="36" r="2" fill="#fff"/>
      </svg>
    </div>
  </div>
</div>
<script>
  (function () {
    function pgCourierDrive(track) {
      var road = track.querySelector('.pg-p-delivery-road');
      var courier = track.querySelector('.pg-p-delivery-courier');
      if (!road || !courier) return;
      var travel = Math.max(0, road.clientWidth - courier.clientWidth);
      courier.style.setProperty('--pg-cart-travel', travel + 'px');
    }
    function pgCourierInitAll() {
      document.querySelectorAll('[data-pg-delivery]').forEach(pgCourierDrive);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', pgCourierInitAll);
    } else {
      pgCourierInitAll();
    }
    window.addEventListener('resize', pgCourierInitAll);
    document.addEventListener('shopify:section:load', pgCourierInitAll);
  })();
</script>
