{% comment %} Carrito animado — va debajo de la barra azul (separado) {% endcomment %}
<div class="pg-p-delivery-track" data-pg-delivery aria-hidden="true">
  <div class="pg-p-delivery-road">
    <span class="pg-p-delivery-line"></span>
    <div class="pg-p-delivery-cart">
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M10 12h6l5.2 26h28.6L56 22H20.8" stroke="#054497" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle class="pg-cart-wheel" cx="27" cy="46" r="4.5" fill="#0b1a3a"/>
        <circle cx="27" cy="46" r="1.8" fill="#fff"/>
        <circle class="pg-cart-wheel" cx="43" cy="46" r="4.5" fill="#0b1a3a"/>
        <circle cx="43" cy="46" r="1.8" fill="#fff"/>
        <path d="M10 12h6l2 10" stroke="#f39200" stroke-width="3.2" stroke-linecap="round"/>
        <rect x="24" y="24" width="22" height="3" rx="1.5" fill="#f39200" opacity="0.85"/>
      </svg>
    </div>
  </div>
</div>
<script>
  (function () {
    function pgCartDrive(track) {
      var road = track.querySelector('.pg-p-delivery-road');
      var cart = track.querySelector('.pg-p-delivery-cart');
      if (!road || !cart) return;
      var travel = Math.max(0, road.clientWidth - cart.clientWidth);
      cart.style.setProperty('--pg-cart-travel', travel + 'px');
    }
    function pgCartInitAll() {
      document.querySelectorAll('[data-pg-delivery]').forEach(pgCartDrive);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', pgCartInitAll);
    } else {
      pgCartInitAll();
    }
    window.addEventListener('resize', pgCartInitAll);
    document.addEventListener('shopify:section:load', pgCartInitAll);
  })();
</script>
