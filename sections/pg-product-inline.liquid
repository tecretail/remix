{% comment %} Product preview = React product-embed (igualito) {% endcomment %}
{{ 'pg-product-react.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pg-delivery-courier.js' | asset_url }}" defer></script>

{% liquid
  assign featured = section.settings.featured_product
  if featured == blank
    assign featured = collections.products.products.first
  endif
  if featured == blank
    assign featured = collections.all.products.first
  endif
%}

<section class="lv-preview-embed-wrap">
  {% render 'pg-buybox-from-section', product: featured, hide_description: true, section_obj: section %}

  {% for block in section.blocks %}
    {% if block.type == '@app' %}
      <div class="pg-app-block" {{ block.shopify_attributes }}>
        {% render block %}
      </div>
    {% endif %}
  {% endfor %}
</section>

{% schema %}
{
  "name": "PG Producto (preview)",
  "tag": "section",
  "class": "pg-section-product",
  "settings": [
    {
      "type": "product",
      "id": "featured_product",
      "label": "Producto"
    },
    {
      "type": "header",
      "content": "Visibilidad"
    },
    {
