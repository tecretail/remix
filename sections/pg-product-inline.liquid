      "id": "title_size",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Tamano titulo",
      "default": 34
    },
    {
      "type": "range",
      "id": "gallery_min_height",
      "min": 0,
      "max": 640,
      "step": 20,
      "unit": "px",
      "label": "Alto minimo galeria (0 = auto)",
