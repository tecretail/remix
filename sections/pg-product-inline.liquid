        { "value": "under_buybox", "label": "Debajo del buybox" },
        { "value": "under_gallery", "label": "Debajo de la galeria" },
        { "value": "none", "label": "Ocultar" }
      ],
      "default": "below"
    },
    {
      "type": "range",
      "id": "section_max_width",
