    {
      "type": "range",
      "id": "cta_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Tamano texto boton",
      "default": 15
    },
    {
      "type": "range",
      "id": "cta_pad_y",
      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Padding vertical boton",
      "default": 14
    },
    {
      "type": "range",
      "id": "cta_pad_x",
      "min": 12,
      "max": 48,
