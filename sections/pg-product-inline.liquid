      "id": "color_badge",
      "label": "Badge medico",
      "default": "#054497"
    },
    {
      "type": "color",
      "id": "color_off",
      "label": "Badge % OFF",
      "default": "#d40000"
    },
    {
      "type": "color",
      "id": "color_cta_bg",
      "label": "Boton fondo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_cta_text",
      "label": "Boton texto",
      "default": "#054497"
    },
    {
      "type": "color",
      "id": "color_cta_border",
      "label": "Boton borde",
