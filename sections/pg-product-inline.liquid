      "label": "Titulo 2",
      "default": "Garantía al 100%"
    },
    {
      "type": "textarea",
      "id": "acc_guarantee_body",
      "label": "Texto 2 (al abrir)",
      "default": "Compra con total confianza. Si no quedas satisfecho, te respaldamos con nuestra garantía al 100%."
    },
    {
