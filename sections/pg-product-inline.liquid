    },
    {
      "type": "range",
      "id": "desc_max_width",
      "min": 480,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Ancho max. descripcion",
      "default": 1280
    },
    {
      "type": "range",
      "id": "desc_pad",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Padding descripcion",
      "default": 16
    },
    {
      "type": "range",
      "id": "desc_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Radio descripcion",
      "default": 14
    },
    {
      "type": "range",
      "id": "desc_margin_top",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Margen superior descripcion",
      "default": 8
    },
    {
      "type": "color",
      "id": "color_bar",
      "label": "Barra superior",
      "default": "#054497"
    },
    {
      "type": "color",
      "id": "color_title",
      "label": "Titulo",
